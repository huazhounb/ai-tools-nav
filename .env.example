NUXT_PUBLIC_SITE_NAME="AI工具箱"
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# App base URL. 本地开发使用 http://localhost:3000，线上使用 Vercel 域名。
APP_BASE_URL="http://localhost:3000"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Browser-side Supabase SDK aliases
NUXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NUXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Login switches
GOOGLE_LOGIN_ENABLED="true"
WECHAT_LOGIN_ENABLED="false"
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECHAT_REDIRECT_URI=""

# CAPTCHA
NUXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Existing server settings
NUXT_ADMIN_TOKEN="change-me"
CONTACT_EMAIL="hello@example.com"
ADMIN_NOTIFY_EMAIL="hello@example.com"
RESEND_API_KEY=""
EMAIL_FROM="AI工具箱 <noreply@example.com>"
DATABASE_URL=""
SUBMISSION_RATE_LIMIT="10/hour"
ENABLE_SPONSOR_SLOTS="true"
ENABLE_INDEX_NOW="false"
